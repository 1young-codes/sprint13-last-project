{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -c \"alias.agent-git-hook=!sh .agent-git/run.sh\" agent-git-hook hook codex session",
            "timeout": 30,
            "additionalContextLimit": 20000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -c \"alias.agent-git-hook=!sh .agent-git/run.sh\" agent-git-hook hook codex pre",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -c \"alias.agent-git-hook=!sh .agent-git/run.sh\" agent-git-hook hook codex post",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -c \"alias.agent-git-hook=!sh .agent-git/run.sh\" agent-git-hook hook codex stop",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
