{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -c \"alias.agent-git-hook=!sh .agent-git/run.sh\" agent-git-hook hook claude session",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "git -c \"alias.agent-git-hook=!sh .agent-git/run.sh\" agent-git-hook hook claude pre",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "git -c \"alias.agent-git-hook=!sh .agent-git/run.sh\" agent-git-hook hook claude post",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -c \"alias.agent-git-hook=!sh .agent-git/run.sh\" agent-git-hook hook claude stop",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
