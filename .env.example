# 카메라 앵글 바꾸기 기능의 경로. 비워 두면 models/generative_ai/camera_angle_presets/settings.toml 값(프로젝트 루트 기준 상대 경로)을 씁니다.
# 모델 가중치 위치는 허깅페이스 캐시 환경 변수 HF_HOME을 따릅니다.
CAMERA_ANGLE_CODE_DIR=
CAMERA_ANGLE_OUTPUT_DIR=

# 해시태그 만들기(models/generative_ai/llm/hashtags.py)에 쓰는 Google Gemini API 키. Google AI Studio에서 만듭니다.
# 비워 두면 해시태그를 만들지 않고 빈 목록을 돌려줍니다.
GEMINI_API_KEY=
# 쓸 모델. 비워 두면 gemini-3.5-flash-lite
GEMINI_MODEL=

# 상품 문구 모델. 비워 두면 gpt-5-mini. 공유 API에서 지원하는 모델 ID를 지정합니다.
OPENAI_CAPTION_MODEL=
# 추론 effort. 비워 두면 API 요청에서 생략합니다. 선택한 모델이 지원하는 값을 지정합니다.
OPENAI_CAPTION_REASONING_EFFORT=
